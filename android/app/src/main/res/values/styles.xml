<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Theme.DeviceDefault.NoActionBar is universally available since API 14
        and adapts to whatever Android variant the device runs (Fire OS in our
        case). Immersive fullscreen is applied in MainActivity at runtime so
        we don't depend on the Fullscreen theme variant existing.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
